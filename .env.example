# Supabase Configuration
# Заполните эти переменные из панели управления Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Примечание:
# Если переменные не заданы или проект запускается локально без подключения к интернету,
# сайт автоматически переключается в локальный режим демонстрации с полным каталогом,
# сохранением заказов в локальной памяти браузера и тестовым доступом к админ-панели.
